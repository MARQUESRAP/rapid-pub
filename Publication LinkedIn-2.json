    {
      "parameters": {
        "jsCode": "// Recuperer les posts des deux sources\nconst postsValeur = $('Recuperer Posts Valeur').all().map(item => ({\n  ...item.json,\n  post_type: 'valeur',\n  table_name: 'posts'\n}));\n\nconst postsPromo = $('Recuperer Posts Promo').all().map(item => ({\n  ...item.json,\n  post_type: 'promo',\n  table_name: 'posts_promo'\n}));\n\n// Combiner et trier par date de publication prevue\nconst allPosts = [...postsValeur, ...postsPromo]\n  .filter(post => post.id) // Filtrer les resultats vides\n  .sort((a, b) => {\n    const dateA = new Date(a.date_publication_prevue || '9999-12-31');\n    const dateB = new Date(b.date_publication_prevue || '9999-12-31');\n    return dateA - dateB;\n  });\n\nif (allPosts.length === 0) {\n  return [{ json: { no_posts: true } }];\n}\n\nreturn allPosts.map(post => ({ json: post }));"
      },
