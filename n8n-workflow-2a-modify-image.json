    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst previousData = $('Save Previous Image URL').first().json;\n\n// Extract content from Anthropic response\nlet content = response.message?.content || (Array.isArray(response.content) ? response.content[0].text : response.content) || response.text;\n\n// Clean markdown wrapping if present\nif (typeof content === 'string') {\n  content = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  try {\n    content = JSON.parse(content);\n  } catch (error) {\n    throw new Error('Claude did not return valid JSON: ' + content);\n  }\n}\n\nreturn {\n  json: {\n    post_id: previousData.post_id,\n    current_image_url: previousData.current_image_url,\n    image_precedente: previousData.image_precedente,\n    prompt_nano_banana: content.prompt_nano_banana,\n    resolution: content.resolution || '2K',\n    aspect_ratio: content.aspect_ratio || '1:1',\n    justification: content.justification\n  }\n};"
      },
      "name": "Parse Enriched Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1350,
        300
      ]
