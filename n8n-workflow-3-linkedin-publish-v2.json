      "parameters": {
        "jsCode": "const error = $input.first().json;\n\nlet postId = 'unknown';\nlet postType = 'unknown';\nlet titre = 'Inconnu';\nlet tableName = 'posts';\n\ntry {\n  const postData = $('Prepare Post Data').first().json;\n  postId = postData?.post_id || 'unknown';\n  postType = postData?.post_type || 'unknown';\n  titre = postData?.titre || 'Inconnu';\n  tableName = postData?.table_name || 'posts';\n} catch (e) {\n  // Prepare Post Data may not have run yet\n}\n\nreturn {\n  json: {\n    post_id: postId,\n    post_type: postType,\n    table_name: tableName,\n    titre: titre,\n    error_message: error.message || 'Erreur lors de la publication LinkedIn',\n    error_details: JSON.stringify(error, null, 2),\n    timestamp: new Date().toISOString()\n  }\n};"
