    {
      "parameters": {
        "jsCode": "const post = $input.first().json;\n\n// Construire le contenu du post LinkedIn\nconst parts = [];\nif (post.hook) parts.push(post.hook);\nif (post.corps) parts.push(post.corps);\nif (post.cta) parts.push(post.cta);\nif (post.hashtags) {\n  // S'assurer que les hashtags sont une string\n  const hashtagsStr = Array.isArray(post.hashtags) \n    ? post.hashtags.join(' ') \n    : post.hashtags;\n  parts.push(hashtagsStr);\n}\n\nconst content = parts.join('\\n\\n');\n\n// Determiner l'image a utiliser\n// Pour les promos: image_transformee_url\n// Pour les valeur: image_url\nlet imageUrl = post.image_url;\nif (post.post_type === 'promo' && post.image_transformee_url) {\n  imageUrl = post.image_transformee_url;\n}\n\nreturn {\n  json: {\n    post_id: post.id,\n    post_type: post.post_type,\n    table_name: post.table_name,\n    content: content,\n    image_url: imageUrl,\n    titre: post.titre_interne || post.nom_produit || 'Post LinkedIn',\n    // PLACEHOLDER: Remplacer par votre Organization URN LinkedIn\n    organization_urn: 'urn:li:organization:XXXXXXXX'\n  }\n};"
      },
