      "parameters": {
        "jsCode": "const items = $input.all();\nconst parsedPosts = $('Parse Posts').all();\n\nreturn items.map((item, index) => {\n  const post = parsedPosts[index]?.json || {};\n  let scoreData = item.json.message?.content || (Array.isArray(item.json.content) ? item.json.content[0].text : item.json.content) || item.json;\n\n  if (typeof scoreData === 'string') {\n    scoreData = JSON.parse(scoreData);\n  }\n\n  return {\n    json: {\n      ...post,\n      score_ia: scoreData.score_final || 7,\n      suggestions_ia: scoreData.suggestions || ''\n    }\n  };\n});"
      },
