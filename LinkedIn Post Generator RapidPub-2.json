    {
      "parameters": {
        "jsCode": "const allItems = items.map(item => item.json);\n\nfunction cleanText(text) {\n  if (!text) return '';\n  return text\n    .replace(/<[^>]*>/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .substring(0, 1000);\n}\n\nconst seen = new Set();\nconst cleaned = [];\n\nfor (const item of allItems) {\n  const key = (item.title || item.text || item.content || '').substring(0, 100);\n  if (key && !seen.has(key)) {\n    seen.add(key);\n    cleaned.push({\n      source: item.source || item.companyName || 'RSS',\n      title: cleanText(item.title || ''),\n      content: cleanText(item.content || item.text || item.description || ''),\n      engagement: item.likes || item.reactions || item.numLikes || 0,\n      comments: item.comments || item.numComments || 0,\n      date: item.pubDate || item.postedAt || item.date || new Date().toISOString(),\n      url: item.link || item.url || item.postUrl || ''\n    });\n  }\n}\n\nconst sorted = cleaned\n  .sort((a, b) => (b.engagement + b.comments) - (a.engagement + a.comments))\n  .slice(0, 40);\n\nreturn [{ json: { veille_data: sorted, count: sorted.length } }];"
      },
