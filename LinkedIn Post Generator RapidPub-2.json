        "jsCode": "let content = $input.first().json.message?.content || (Array.isArray($input.first().json.content) ? $input.first().json.content[0].text : $input.first().json.content);\n\nif (typeof content === 'string') {\n  content = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '');\n  content = JSON.parse(content);\n}\n\nconst posts = content.posts || content;\n\nconst enrichedPosts = posts.map((post, index) => ({\n  ...post,\n  date_generation: new Date().toISOString(),\n  statut: 'A_Valider',\n  score_ia: 0,\n  suggestions_ia: ''\n}));\n\nreturn enrichedPosts.map(post => ({ json: post }));"
      },
